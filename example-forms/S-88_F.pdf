/JS (// Script S-88\r\n// Created: 1-23-2019\r\n// this script calculates the average meeting attendance, if this is in the Total field at // the bottom the average will be based on fields that are not empty\r\n// Important information: This script should be added to all the Total and Average fields\r\n// \r\n\r\n// Setup variables\r\n\r\n// srcName pulls the name of the field containing this script \r\nvar srcName = event.target.name;\r\n\r\n// srcCategory identifies if this is either the Total or Average fields\r\n\r\nvar srcCategory = srcName.substring\(srcName.indexOf\("_"\)+1\)\r\n\r\n// mName is the field name of total meetings for the month\r\nvar mName = srcName.replace\("Average","Meeting"\);\r\n\r\n// aName is the field name of total attendance for the month\r\nvar aName = srcName.replace\("Average","Attendance"\);\r\n\r\n// baseName contains the base name of the field that contains this script\r\nvar baseName = srcName.substring\(0,srcName.indexOf\("_"\)\);\r\n\r\n\r\n// total will accrue the total amount for each month\r\n\r\nvar totalAverage = Number\(0\);\r\n\r\n// lastMonth will be the last month that contained a value greater that zero, this will be used to calculate the average\r\n\r\nvar lastMonth = 0;\r\n\r\n\r\n\r\n\r\n\r\nif\(srcCategory == "Total"\){\r\n    for\(i=1; i < 13; i++\){\r\n        var thisMonth = baseName + "_" + i;\r\n        var monthVal = this.getField\(thisMonth\).value;\r\n        totalAverage = Number\(totalAverage\) + Number\(monthVal\);\r\n        if\(monthVal > 0\){\r\n            lastMonth = i;\r\n        }\r\n    }\r\n    \r\n    if\(totalAverage == 0\){\r\n        event.value = "";\r\n    }\r\n    else if\(totalAverage != 0\){\r\n        event.value = totalAverage / lastMonth;\r\n    }\r\n}\r\nelse if\(srcCategory != "Total"\){\r\n    var meeting = this.getField\(mName\).value;\r\n    var attend = this.getField\(aName\).value;\r\n    if\(meeting == 0 || attend == 0\){\r\n        event.value = "";\r\n    }\r\n    else{\r\n        event.value = attend / meeting;\r\n    }\r\n})
/S /JavaScript
>>
